---
import BaseLayout from "../layouts/baselayout.astro";
---

<BaseLayout title="ホーム | My Blog">

  <div class = "container">
    <p>
      aaaaaaaaaaaaaaaaaaaaaaaaaaaa<br>
      aaaaaaaaaaaaaaaaaaaaaaaaaaaa<br>
      aaaaaaaaaHello Worldaaaaaaaa<br>
      aaaaaaaaaaaaaaaaaaaaaaaaaaaa<br>
      aaaaaaaaaaaaaaaaaaaaaaaaaaaa<br>

    </p>
    
    <a href={import.meta.env.BASE_URL + '/blog/'}>ブログ一覧</a>
  </div>


</BaseLayout>

<style is:global>
  .container {
    display: flex;           /* 「この部屋の中の家具（子）を綺麗に並べます」宣言 */
    flex-direction: column;  /* 家具を「縦」に並べる（上から下へ） */
    align-items: center;     /* 家具を「左右の真ん中」に置く */
    justify-content: center; /* 家具を「上下の真ん中」に置く */
    min-height: 3vh;       /* 部屋の高さを「画面全体の高さ」まで広げる */

    gap: 24px;
  }
</style>