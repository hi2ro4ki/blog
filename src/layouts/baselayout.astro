---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <header>

    <h1><a href={import.meta.env.BASE_URL}>My Blog</a></h1>
    <nav>
      <a href={import.meta.env.BASE_URL}>ホーム</a>
      <a href={import.meta.env.BASE_URL + '/about/'}>About</a>
    </nav>

    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>My Blog</p>
    </footer>
  </body>
</html>
